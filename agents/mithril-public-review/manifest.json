{
  "schemaVersion": "1",
  "id": "mithril-public-review",
  "category": "security",
  "name": "Mithril Public Code Review",
  "version": "0.2.0",
  "description": "Public GitHub commit review using bounded JavaScript/TypeScript AST extraction and actual Mithril ontology receipts; incomplete coverage and candidates require review.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://github.com/mithril-lang/mithril-system-one",
  "tags": [
    "mithril",
    "ontology",
    "security",
    "public-source",
    "github"
  ],
  "permissions": [
    "network:api.github.com",
    "network:raw.githubusercontent.com",
    "subprocess:node-fixed-entrypoint"
  ],
  "type": "agent",
  "artifact": {
    "format": "git",
    "url": "https://github.com/mithril-lang/mithril-system-one",
    "commit": "f3d07ef403c2c018a1eba5b8d4eabd9a903235e8",
    "entry": "bin/mithril-public-review.mjs"
  },
  "command": "node",
  "args": [
    "${system_one_root}/bin/mithril-public-review.mjs",
    "--stdin"
  ],
  "entry": "bin/mithril-public-review.mjs",
  "requirements": {
    "commands": [
      "node",
      "git",
      "npm"
    ]
  },
  "configuration": {
    "system_one_root": "Reviewed artifact.commit checkout; npm ci --ignore-scripts then npm run setup:dynamic. No inference credential is used by the review tool."
  },
  "env": {},
  "executable": true,
  "tools": [
    "mithril_public_repo_review"
  ],
  "execution": {
    "runtime": "mithril-system-one",
    "input": "json-stdin",
    "maxTasks": 1,
    "stopOnFailure": true,
    "retryUnknown": false
  },
  "botProfile": {
    "id": "mithril-public-code-review",
    "config": "profile/config.yaml",
    "instructions": "profile/SOUL.md",
    "metadata": "profile/profile.yaml",
    "requiresOwnCredentialForConversation": true
  }
}
