{
  "schemaVersion": "1",
  "id": "mithril-public-review",
  "category": "security",
  "name": "Mithril Public Code Review",
  "version": "0.4.0",
  "description": "Public code/dependency review, SCAP OVAL/XCCDF result ontology, and isolated same-major npm security patches with OSV/Mithril reassessment; incomplete scope and untested compatibility remain explicit.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://github.com/mithril-lang/mithril-system-one",
  "tags": [
    "mithril",
    "ontology",
    "security",
    "public-source",
    "github"
  ],
  "permissions": [
    "network:api.github.com",
    "network:raw.githubusercontent.com",
    "subprocess:node-fixed-entrypoint",
    "network:api.osv.dev",
    "network:knowledge.mithril.fund",
    "network:registry.npmjs.org",
    "subprocess:python-fixed-entrypoint",
    "subprocess:npm-fixed-entrypoint",
    "filesystem:temporary-workspace"
  ],
  "type": "agent",
  "artifact": {
    "format": "git",
    "url": "https://github.com/mithril-lang/mithril-system-one",
    "commit": "b04d20cedb98d5f937225da1df713af8185a6d1e",
    "entry": "bin/mithril-public-review.mjs"
  },
  "command": "node",
  "args": [
    "${system_one_root}/bin/mithril-public-review.mjs",
    "--stdin"
  ],
  "entry": "bin/mithril-public-review.mjs",
  "requirements": {
    "commands": [
      "node",
      "git",
      "npm",
      "python3"
    ]
  },
  "configuration": {
    "system_one_root": "Reviewed artifact.commit checkout; npm ci --ignore-scripts, npm run setup:dynamic and npm run setup:dependencies -- --engine-root /absolute/reviewed/security-core. Private matcher access is separately required. No review-tool inference credential."
  },
  "env": {},
  "executable": true,
  "tools": [
    "mithril_public_repo_review",
    "mithril_scap_review",
    "mithril_dependency_upgrade"
  ],
  "execution": {
    "runtime": "mithril-system-one",
    "input": "json-stdin",
    "maxTasks": 1,
    "stopOnFailure": true,
    "retryUnknown": false
  },
  "botProfile": {
    "id": "mithril-public-code-review",
    "config": "profile/config.yaml",
    "instructions": "profile/SOUL.md",
    "metadata": "profile/profile.yaml",
    "requiresOwnCredentialForConversation": true
  }
}
