  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://github.com/mithril-lang/mithril-system-one",
  "tags": [
    "mithril",
    "ontology",
    "security",
    "public-source",
    "github"
  ],
  "permissions": [
    "network:api.github.com",
    "network:raw.githubusercontent.com",
    "subprocess:node-fixed-entrypoint",
    "network:api.osv.dev",
    "network:knowledge.mithril.fund",
    "network:registry.npmjs.org",
    "subprocess:python-fixed-entrypoint",
    "subprocess:npm-fixed-entrypoint",
    "filesystem:temporary-workspace"
  ],
  "type": "plugin",
  "artifact": {
    "format": "git",
    "url": "https://github.com/mithril-lang/mithril-system-one/tree/cd7905e62b22396212ae0da77d45daedbb017471/adapters/hermes/mithril-public-review",
    "commit": "cd7905e62b22396212ae0da77d45daedbb017471"
  },
  "compatibility": {
    "clients": [
      {
        "name": "Hermes Agent",
        "version": ">=0.21.4,<0.22",
        "tested": "0.21.5+4485.g3da66ca.dirty"
      }
    ],
    "platforms": [
      "macos"
    ]
  },
  "requirements": {
    "commands": [
      "node",
      "git",
      "npm",
      "python3"
    ]
  },
  "tools": [
    "mithril_public_repo_review",
    "mithril_scap_review",
    "mithril_dependency_upgrade",
    "mithril_business_process_review"
  ]
}
