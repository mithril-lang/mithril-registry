{
  "schemaVersion": "1",
  "id": "mithril-public-review",
  "category": "security",
  "name": "Mithril Public Code Review",
  "version": "0.6.0",
  "description": "Public source/dependency and SCAP review plus bounded BPMN business-process ontology assessment: approval paths, declared principal separation, authorization and audit. Incomplete operational evidence remains explicit.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://github.com/mithril-lang/mithril-system-one",
  "tags": [
    "mithril",
    "ontology",
    "security",
    "public-source",
    "github"
  ],
  "permissions": [
    "network:api.github.com",
    "network:raw.githubusercontent.com",
    "subprocess:node-fixed-entrypoint",
    "network:api.osv.dev",
    "network:knowledge.mithril.fund",
    "network:registry.npmjs.org",
    "subprocess:python-fixed-entrypoint",
    "subprocess:npm-fixed-entrypoint",
    "filesystem:temporary-workspace"
  ],
  "type": "mcp",
  "artifact": {
    "format": "git",
    "url": "https://github.com/mithril-lang/mithril-system-one",
    "commit": "cd7905e62b22396212ae0da77d45daedbb017471",
    "entry": "bin/mithril-public-mcp.mjs"
  },
  "command": "node",
  "args": [
    "${system_one_root}/bin/mithril-public-mcp.mjs"
  ],
  "entry": "bin/mithril-public-mcp.mjs",
  "requirements": {
    "commands": [
      "node",
      "git",
      "npm",
      "python3"
    ]
  },
  "configuration": {
    "system_one_root": "Reviewed artifact.commit checkout; npm ci --ignore-scripts, npm run setup:dynamic and npm run setup:dependencies -- --engine-root /absolute/reviewed/security-core. Private matcher access is separately required. No review-tool inference credential."
  },
  "env": {},
  "executable": true,
  "transport": "stdio",
  "protocolVersion": "2025-06-18",
  "authentication": {
    "mode": "per-tool",
    "credentialSource": "none"
  },
  "tools": [
    {
      "name": "mithril_public_repo_review",
      "authentication": "none",
      "effect": "read"
    },
    {
      "name": "mithril_scap_review",
      "authentication": "none",
      "effect": "read"
    },
    {
      "name": "mithril_dependency_upgrade",
      "authentication": "none",
      "effect": "write"
    },
    {
      "name": "mithril_business_process_review",
      "authentication": "none",
      "effect": "read"
    }
  ]
}
