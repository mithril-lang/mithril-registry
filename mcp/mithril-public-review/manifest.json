{
  "schemaVersion": "1",
  "id": "mithril-public-review",
  "category": "security",
  "name": "Mithril Public Code Review",
  "version": "0.3.1",
  "description": "Public GitHub source and locked npm dependency review with full OSV matching, Knowledge enrichment and actual Mithril ontology receipts; candidates and unknown coverage require review.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://github.com/mithril-lang/mithril-system-one",
  "tags": [
    "mithril",
    "ontology",
    "security",
    "public-source",
    "github"
  ],
  "permissions": [
    "network:api.github.com",
    "network:raw.githubusercontent.com",
    "subprocess:node-fixed-entrypoint",
    "network:api.osv.dev",
    "network:knowledge.mithril.fund"
  ],
  "type": "mcp",
  "artifact": {
    "format": "git",
    "url": "https://github.com/mithril-lang/mithril-system-one",
    "commit": "5a86517627b874e4911d16cb3fb565c318fb07b0",
    "entry": "bin/mithril-public-mcp.mjs"
  },
  "command": "node",
  "args": [
    "${system_one_root}/bin/mithril-public-mcp.mjs"
  ],
  "entry": "bin/mithril-public-mcp.mjs",
  "requirements": {
    "commands": [
      "node",
      "git",
      "npm"
    ]
  },
  "configuration": {
    "system_one_root": "Reviewed artifact.commit checkout; npm ci --ignore-scripts, npm run setup:dynamic and npm run setup:dependencies -- --engine-root /absolute/reviewed/security-core. Private matcher access is separately required. No review-tool inference credential."
  },
  "env": {},
  "executable": true,
  "transport": "stdio",
  "protocolVersion": "2025-06-18",
  "authentication": {
    "mode": "per-tool",
    "credentialSource": "none"
  },
  "tools": [
    {
      "name": "mithril_public_repo_review",
      "authentication": "none",
      "effect": "read"
    }
  ]
}
