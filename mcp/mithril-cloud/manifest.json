{
  "schemaVersion": "1",
  "type": "mcp",
  "id": "mithril-cloud",
  "category": "research",
  "name": "Mithril Cloud MCP",
  "version": "1.0.0",
  "description": "Connect to Mithril's public evidence search and model catalog, with separate account authorization for research status and inference.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://github.com/cloud-kotoba/app-kotoba-cloud/blob/ff514610ec0a3f8bc7bf6dfdf220bc0df2955e84/src/app_kotoba_cloud/mcp.cljk",
  "tags": ["research", "security", "knowledge", "models"],
  "transport": "streamable-http",
  "url": "https://mithril.fund/mcp",
  "protocolVersion": "2025-06-18",
  "authentication": {
    "mode": "per-tool",
    "credentialSource": "https://console.mithril.fund/account",
    "credentialHeader": "Authorization"
  },
  "permissions": ["network:mithril.fund", "public-data:read", "research-inference:optional"],
  "tools": [
    {"name": "kotoba_knowledge_search", "authentication": "none", "effect": "read"},
    {"name": "kotoba_knowledge_context", "authentication": "none", "effect": "read"},
    {"name": "kotoba_models", "authentication": "none", "effect": "read"},
    {"name": "kotoba_research_status", "authentication": "personal-api-token", "effect": "read"},
    {"name": "kotoba_chat_completion", "authentication": "personal-api-token", "effect": "inference", "billing": "account-plan-dependent"}
  ],
  "documentation": "https://mithril.fund/agent-quickstart.md"
}
