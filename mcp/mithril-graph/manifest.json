{
  "schemaVersion": "1",
  "type": "mcp",
  "id": "mithril-graph",
  "category": "data",
  "name": "Mithril Graph MCP",
  "version": "1.0.1",
  "description": "Connect to Mithril's Graph MCP endpoint, which currently serves one public read tool (graph_docs) returning documentation and receipt links.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://graph.mithril.fund/.well-known/mcp.json",
  "tags": [
    "graph",
    "ontology",
    "database",
    "ipld"
  ],
  "transport": "streamable-http",
  "url": "https://graph.mithril.fund/mcp",
  "protocolVersion": "2025-06-18",
  "authentication": {
    "mode": "per-tool",
    "credentialSource": "https://graph.mithril.fund/agent-quickstart.md",
    "credentialHeader": "Authorization"
  },
  "permissions": [
    "network:graph.mithril.fund",
    "public-data:read"
  ],
  "tools": [
    {
      "name": "graph_docs",
      "authentication": "none",
      "effect": "read"
    }
  ],
  "documentation": "https://graph.mithril.fund/agent-quickstart.md"
}
