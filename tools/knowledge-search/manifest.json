{
  "schemaVersion": "1",
  "type": "tool",
  "id": "knowledge-search",
  "category": "research",
  "name": "Knowledge Search",
  "version": "1.1.0",
  "description": "Search public security evidence by query and return source-linked results.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://mithril.fund/.well-known/mcp.json",
  "tags": [
    "research",
    "security",
    "knowledge"
  ],
  "catalog": {
    "url": "https://mithril.fund/.well-known/mcp.json",
    "name": "mithril_knowledge_search"
  },
  "http": {
    "method": "GET",
    "url": "https://mithril.fund/v1/knowledge/search",
    "query": {
      "q": "q"
    }
  },
  "authentication": "none",
  "effect": "read",
  "permissions": [
    "network:mithril.fund",
    "public-data:read"
  ],
  "inputSchema": {
    "type": "object",
    "required": [
      "q"
    ],
    "properties": {
      "q": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "snapshot",
      "results",
      "limit"
    ],
    "properties": {
      "snapshot": {
        "type": "object"
      },
      "results": {
        "type": "array"
      },
      "limit": {
        "type": "integer"
      }
    }
  }
}
