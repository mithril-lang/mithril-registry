{
  "schemaVersion": "1",
  "type": "tool",
  "id": "knowledge-search",
  "category": "research",
  "name": "Knowledge Search",
  "version": "1.0.0",
  "description": "Search public security evidence by query and return source-linked results.",
  "author": "Mithril",
  "license": "Apache-2.0",
  "source": "https://github.com/cloud-kotoba/app-kotoba-cloud/blob/ff514610ec0a3f8bc7bf6dfdf220bc0df2955e84/src/app_kotoba_cloud/mcp.cljk",
  "tags": ["research", "security", "knowledge"],
  "mcp": {"entry": "mithril-cloud", "name": "kotoba_knowledge_search"},
  "http": {"method": "GET", "url": "https://mithril.fund/v1/knowledge/search", "query": {"q": "q"}},
  "authentication": "none",
  "effect": "read",
  "permissions": ["network:mithril.fund", "public-data:read"],
  "inputSchema": {
    "type": "object",
    "required": ["q"],
    "properties": {"q": {"type": "string", "minLength": 1, "maxLength": 200}},
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["snapshot", "results", "limit"],
    "properties": {"snapshot": {"type": "object"}, "results": {"type": "array"}, "limit": {"type": "integer"}}
  }
}
